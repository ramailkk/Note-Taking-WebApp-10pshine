# =====================================================================
# Note-Taking-WebApp — Environment Variables
# Copy this file to .env and fill in the values.
# Add all of these to your Vercel project's Environment Variables too.
# =====================================================================

# -----------------------------------------------------------------------
# Database (Supabase)
# -----------------------------------------------------------------------
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string
# Use the "Transaction" mode pooler URI (port 6543) for serverless environments:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------
# A long, random secret string. Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------
# Email (Gmail — used for verification emails via Nodemailer)
# -----------------------------------------------------------------------
# Use a Gmail App Password (not your real password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password

# -----------------------------------------------------------------------
# App URL (your Vercel deployment domain)
# -----------------------------------------------------------------------
# This is used to build the email verification link.
# In production, set this to your Vercel URL e.g. https://your-app.vercel.app
# Vercel also provides VERCEL_URL automatically, which is used as a fallback.
APP_URL=https://your-app.vercel.app
