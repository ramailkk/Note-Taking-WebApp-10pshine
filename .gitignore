# Global ignore for node_modules
**/node_modules/
**/dist/
**/build/

# Environment files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
# .env.example is intentionally NOT ignored — it's safe to commit

# System files
.DS_Store
Thumbs.db

# Logs
*.log

# SonarQube 
.scannerwork/
